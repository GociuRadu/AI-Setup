# Only the AI source is versioned. Generated tool folders, project folders, device files and tool caches stay local.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/_ai/
# Local setup page (React + Vite); its build output stays local
!/setup-ui/
setup-ui/dist/
# Reports about the setup itself
!/docs/

# Never commit secrets or caches anywhere
.env
.env.*
!.env.example
*.env
node_modules/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
