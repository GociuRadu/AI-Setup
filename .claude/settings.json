{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/local.env)",
      "Read(**/.test.env)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.monitoring)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(*down -v*)",
      "Bash(*down --volumes*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(*compose.production.yml*)",
      "Bash(*compose.staging.yml*)",
      "Bash(*compose.hostinger.yml*)",
      "Bash(*compose.monitoring.yml*)",
      "Bash(*scripts/release.sh*)",
      "Bash(*scripts/rollback.sh*)",
      "Bash(ssh*)",
      "Bash(scp*)",
      "mcp__hostinger-vps__execute",
      "mcp__hostinger-vps__multi-execute",
      "mcp__hostinger-hosting__execute",
      "mcp__hostinger-hosting__multi-execute",
      "mcp__hostinger-agency-hosting__execute",
      "mcp__hostinger-agency-hosting__multi-execute",
      "mcp__hostinger-dns__execute",
      "mcp__hostinger-dns__multi-execute",
      "mcp__hostinger-domains__execute",
      "mcp__hostinger-domains__multi-execute",
      "mcp__hostinger-wordpress__execute",
      "mcp__hostinger-wordpress__multi-execute",
      "mcp__hostinger-wordpress-sites__execute_site_tool",
      "mcp__hostinger-billing__execute",
      "mcp__hostinger-billing__multi-execute"
    ]
  }
}
