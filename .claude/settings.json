{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/*.env)",
      "Edit(**/.env)",
      "Edit(**/*.env)",
      "Read(./personal/**)",
      "Edit(./personal/**)",

      "Bash(git *push*--force*)",
      "Bash(git *push* -f*)",
      "PowerShell(git *push*--force*)",
      "PowerShell(git *push* -f*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "PowerShell(docker volume rm *)",
      "PowerShell(docker volume prune*)",
      "PowerShell(docker system prune*)",
      "Bash(docker*compose*down*-v*)",
      "PowerShell(docker*compose*down*-v*)",
      "Bash(docker*compose*prod*)",
      "PowerShell(docker*compose*prod*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(sftp *)",

      "mcp__hostinger-vps__execute",
      "mcp__hostinger-vps__multi-execute",
      "mcp__hostinger-hosting__execute",
      "mcp__hostinger-hosting__multi-execute",
      "mcp__hostinger-agency-hosting__execute",
      "mcp__hostinger-agency-hosting__multi-execute",
      "mcp__hostinger-dns__execute",
      "mcp__hostinger-dns__multi-execute",
      "mcp__hostinger-domains__execute",
      "mcp__hostinger-domains__multi-execute",
      "mcp__hostinger-wordpress__execute",
      "mcp__hostinger-wordpress__multi-execute",
      "mcp__hostinger-wordpress-sites__execute_site_tool",
      "mcp__hostinger-billing__execute",
      "mcp__hostinger-billing__multi-execute",
      "mcp__hostinger-reach__execute",
      "mcp__hostinger-reach__multi-execute",
      "mcp__claude_ai_Atlassian_MCP__executeDestructive"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/_ai/hooks/lang.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import(require('url').pathToFileURL(require('path').resolve(process.env.CLAUDE_PROJECT_DIR||'','_ai/hooks/guard.mjs')).href).then(m=>m.run(),e=>{console.error('Blocked: the guard hook could not load ('+e.message+'). Fix _ai/hooks/guard.mjs.');process.exit(2)})\""
          }
        ]
      }
    ]
  }
}
