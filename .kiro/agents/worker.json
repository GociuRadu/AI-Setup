{
  "name": "worker",
  "description": "Cheap executor for bulk mechanical edits from a complete spec: the same change across many files, new files from an example, tests from a case table. Several run in parallel on disjoint file sets. Not for design or logic the spec does not give.",
  "model": "claude-haiku-5.5",
  "tools": [
    "glob",
    "grep",
    "read",
    "write"
  ],
  "prompt": "file://../../.claude/agents/worker.md",
  "hooks": [
    {
      "name": "guard read",
      "trigger": "PreToolUse",
      "matcher": "read",
      "action": {
        "type": "command",
        "command": "node _ai/hooks/guard.mjs"
      },
      "timeout": 10
    },
    {
      "name": "guard write",
      "trigger": "PreToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "node _ai/hooks/guard.mjs"
      },
      "timeout": 10
    }
  ],
  "allowedTools": [],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:fda4e229278954aadc232af59d34ba0e151955f6a5579fed4beeff43cd083eca",
    "source": "sha256:394a39594650bb6affcb314ac7d2619d474a5d0c278724a12f25a536d240781d"
  }
}
