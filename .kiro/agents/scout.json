{
  "name": "scout",
  "description": "Cheap search in files, long logs or the public web. Returns evidence with paths or URLs, or writes it to the one report path the brief names. No code edits, no design decisions.",
  "model": "claude-haiku-5.5",
  "tools": [
    "read",
    "glob",
    "grep",
    "web",
    "web_search",
    "web_fetch",
    "write"
  ],
  "prompt": "file://../../.claude/agents/scout.md",
  "hooks": [
    {
      "name": "guard read",
      "trigger": "PreToolUse",
      "matcher": "read",
      "action": {
        "type": "command",
        "command": "node _ai/hooks/guard.mjs"
      },
      "timeout": 10
    },
    {
      "name": "guard write",
      "trigger": "PreToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "node _ai/hooks/guard.mjs"
      },
      "timeout": 10
    }
  ]
}
