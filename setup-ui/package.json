{
  "name": "setup-ui",
  "private": true,
  "type": "module",
  "description": "Local page to view and set the AI setup (tools, profile, models, skills, hooks) and apply it with node _ai/sync.mjs",
  "scripts": {
    "setup-ui": "npm run build && node server.mjs",
    "build": "tsc --noEmit && vite build",
    "api": "node server.mjs",
    "dev": "vite",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
